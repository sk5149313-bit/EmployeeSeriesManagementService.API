            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/employees/personaladdresses": {
      "get": {
        "tags": [
          "Employees"
        ],
        "parameters": [
          {
            "name": "workCity",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "Brussels"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
